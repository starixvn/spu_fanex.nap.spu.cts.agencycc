<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<NoWin32Manifest>true</NoWin32Manifest>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Exclude the project from analysis -->
		<SonarQubeExclude>true</SonarQubeExclude>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="App_Data\DEV\" />
		<Folder Include="App_Data\KLDR\" />
		<Folder Include="App_Data\LOCAL\" />
		<Folder Include="App_Data\SIT\" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.HealthChecks.System" Version="8.0.1" />
		<PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
		<PackageReference Include="Fanex.Data" Version="4.3.4" />
		<PackageReference Include="Fanex.Data.MySql" Version="4.3.4" />
		<PackageReference Include="Fanex.Data.SqlServer" Version="4.3.4" />
		<PackageReference Include="Fanex.Logging.Extensions.Database" Version="2.0.2.1" />
		<PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Fanex.NAP.SPU.CTS.AgencyCC\Fanex.NAP.SPU.CTS.AgencyCC.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.LOCAL_99.json">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>			
		<Content Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="appsettings.LOCAL.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="appsettings.LOCAL_1.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="appsettings.LOCAL_2.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="appsettings.SIT.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="App_Data\DEV\SPNames.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="App_Data\KLDR\SPNames.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="App_Data\LOCAL\SPNames.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="App_Data\SIT\SPNames.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
